{
  "name": "docs-ledger",
  "version": "0.1.1",
  "description": "The archivist skill, agent and hooks: a ledger in .ledger/ that keeps in-progress engineering docs current for later sessions",
  "author": {
    "name": "RR"
  },
  "homepage": "https://github.com/RikusVanRensburg/agentic-marketplace/tree/main/plugins/skills/docs-ledger",
  "repository": "https://github.com/RikusVanRensburg/agentic-marketplace",
  "license": "MIT",
  "keywords": [
    "docs",
    "ledger",
    "archivist",
    "skills"
  ],
  "skills": "./skills/",
  "agents": [
    "./agents/archivist.md"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/archivist/scripts/archivist-session-start.sh\" \"${CLAUDE_PLUGIN_ROOT}\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/archivist/scripts/archivist-post-write.sh\" \"${CLAUDE_PLUGIN_ROOT}\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/archivist/scripts/archivist-stop.sh\" \"${CLAUDE_PLUGIN_ROOT}\""
          }
        ]
      }
    ]
  }
}
