{
  "name": "rr-testing",
  "description": "RR's skills under testing",
  "version": "0.3.2",
  "author": {
    "name": "RR"
  },
  "repository": "https://github.com/flow-software/flow-agentic-resources",
  "license": "MIT",
  "keywords": ["flow", "personal", "rr", "testing"],
  "skills": "./skills/",
  "commands": [],
  "agents": [
    "./agents/archivist.md",
    "./agents/handover-actionability-reviewer.md",
    "./agents/handover-coverage-reviewer.md",
    "./agents/handover-safety-reviewer.md"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/archivist/scripts/archivist-session-start.sh\" \"${CLAUDE_PLUGIN_ROOT}\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/archivist/scripts/archivist-post-write.sh\" \"${CLAUDE_PLUGIN_ROOT}\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/archivist/scripts/archivist-stop.sh\" \"${CLAUDE_PLUGIN_ROOT}\""
          }
        ]
      }
    ]
  },
  "mcpServers": {},
  "lspServers": {}
}
